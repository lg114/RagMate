# ================= LLM CONFIGURATION =================
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
LLM_API_BASE_URL=

# 思考型模型（本地 Qwen3 等）必须设为 none，否则推理过程会占满 reasoning 字段
# 而 content 恒为空，上层只会收到空回复。其他服务商留空即可。
LLM_REASONING_EFFORT=

# ================= EMBEDDING CONFIGURATION =================
# 默认 remote：API 进程不加载 torch / FlagEmbedding，启动时也不预热本地 BGE。
# remote / openai 请求 POST {EMBEDDING_API_BASE_URL}/embeddings。
# URL 为空时进程拒绝启动。EMBEDDING_API_KEY 可选（自建侧车不校验就留空）。
# 切换嵌入方式后必须重新入库。服务若在 data[].sparse（或 lexical_weights）里返回稀疏向量就用它，
# 否则用本地词哈希补 sparse。这个哈希不是 BGE-M3 的 lexical weights。
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PROVIDER=remote
EMBEDDING_NORMALIZE=true
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=           # 必填，如 http://127.0.0.1:8081/v1 或 https://api.openai.com/v1
EMBEDDING_API_TIMEOUT=60

# 本进程 FlagEmbedding（可选，会 import torch 并在启动时预热 BGE-M3）。
# huggingface、local、flagembedding 三者等价。不设下面两项就不会走这条路径。
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_DEVICE=cpu            # 仅本地：cpu 或 cuda
# HF_TOKEN=

# ================= LANGSMITH CONFIGURATION =================
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ragmate
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ================= DATABASE CONFIGURATION =================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragmate
# 留空则不连接 Redis。入库锁/状态/取消、会话历史都在 Postgres；限流用本进程计数。
# 多 worker 共享限流时再填写，并启动可选容器：docker compose --profile redis up -d
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ================= MILVUS CONFIGURATION =================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=ragmate_docs
MILVUS_TIMEOUT=10

# ================= RAG PIPELINE CONFIGURATION =================
# 文档切分
CHUNK_SIZE=1000              # 每个文本片段的字符数（越大信息越完整，但检索精度可能下降）
CHUNK_OVERLAP=200            # 相邻片段的重叠字符数（保持上下文连续性）
CHUNK_SIZE_PDF=600           # PDF technical docs, smaller for precision
CHUNK_OVERLAP_PDF=100
CHUNK_SIZE_DOCX=800          # DOCX documents
CHUNK_OVERLAP_DOCX=150
CHUNK_SIZE_TXT=1000          # Plain text files
CHUNK_OVERLAP_TXT=200
CHUNK_SIZE_TABLE=1500        # Excel table chunk limit (split at row boundaries)

# Parent-child chunking (small-to-big)
CHUNK_SIZE_PARENT=2500        # Parent chunk for LLM context
CHUNK_OVERLAP_PARENT=300
# title_path=默认，子块正文带「H1 > H2 > H3」；parent_child=路径不进检索正文（只进 parent_text）
CHUNKING_STRATEGY=title_path

# 混合检索 + 重排序
HYBRID_SEARCH_ENABLED=true   # 启用稠密+稀疏混合检索（关闭则只用稠密检索）
FUSION_MODE=rrf              # rrf | weighted；改完用 ragmate-eval / fusion sweep 对比后再定
RRF_K=60                     # RRF 常数（默认 60）；扫参见 eval/README
FUSION_DENSE_WEIGHT=0.5      # weighted 时稠密权重，稀疏=1-该值
RERANKER_MODEL=BAAI/bge-reranker-v2-m3  # 重排序模型名，远程和本地都用这个字段
# 默认 api：POST {RERANKER_API_BASE_URL}/rerank，不在本进程加载 CrossEncoder。
# URL 为空时进程拒绝启动。RERANKER_API_KEY 可选。
# 改回本地：RERANKER_PROVIDER=local（会 import sentence-transformers / torch，启动时预热）。
RERANKER_PROVIDER=api
RERANKER_API_BASE_URL=       # 必填，如 http://127.0.0.1:8081/v1 、https://api.jina.ai/v1
RERANKER_API_KEY=
RERANKER_API_TIMEOUT=30
RERANK_CANDIDATES=30         # 重排序候选数量（越大越慢但质量越高）
FINAL_CONTEXT_K=15           # 最终传给 LLM 的最大片段数（动态策略的硬上限）
RERANK_SCORE_THRESHOLD=0.3   # 重排序分数阈值（sigmoid 概率，低于此值的片段被丢弃）
FAITHFULNESS_CHECK=true     # 生成后校验声明是否有依据（默认开，每次 RAG 回答多一次 LLM 调用；false 关闭）
# 默认关闭。true 时 /chat 走 Deep Agents 工具循环；false 时为一次检索、一次生成、再接地。
DEEP_AGENTS_ENABLED=false
MULTI_QUERY_ENABLED=false    # 多查询扩展：LLM 生成改写变体，多路检索后 RRF 融合（默认关，开启前先过评测对比）
MULTI_QUERY_COUNT=3          # 改写变体数量（不含原始查询）
EVAL_LLM_TIMEOUT=60          # 评测生成单次超时（秒）；避免 503 干等
EVAL_LLM_RETRIES=2           # 503/429/超时时额外重试次数
EVAL_LLM_RETRY_BACKOFF=2     # 重试间隔基数（秒）

# ================= 鉴权（可选） =================
# 为空=不鉴权（默认）；设置后 /chat、/documents、/ingest 需带 Authorization: Bearer <token> 或 X-API-Key
API_AUTH_TOKEN=

# ================= CORS =================
# 逗号分隔，生产环境请限制为具体域名，如: https://your-domain.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ================= DOCUMENTS =================
DOCUMENTS_DIR=./documents

# ================= INGEST =================
# 状态、锁、进度、取消标志、失败原因都在 Postgres 的 ingest_control（一行）。
# 持锁进程按心跳续期；心跳超时后状态变为 interrupted。终态不会按 TTL 被清掉。
# INGEST_STATUS_TTL 已不再使用，留着只为兼容旧的 .env。
INGEST_LOCK_TTL=600
INGEST_HEARTBEAT_INTERVAL=5
INGEST_HEARTBEAT_STALE=30

# ==============================================================================
# RagMate - Self-Hosted RAG Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env       (Linux/macOS)
#   copy .env.example .env     (Windows)
# Then start with:
#   docker compose up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Chat LLM (Required)
# ------------------------------------------------------------------------------
# Any OpenAI-compatible chat model API.
# Examples:
#   - OpenAI:      LLM_MODEL=gpt-4o, LLM_API_BASE_URL=https://api.openai.com/v1
#   - DeepSeek:    LLM_MODEL=deepseek-chat, LLM_API_BASE_URL=https://api.deepseek.com/v1
#   - Host Ollama: LLM_MODEL=qwen2.5:7b, LLM_API_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 2. Embedding Model (Required)
# ------------------------------------------------------------------------------
# OpenAI-compatible embeddings endpoint.
# Defaults to BAAI/bge-m3. If using Ollama on the host:
#   EMBEDDING_API_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=

# ------------------------------------------------------------------------------
# 3. Reranker Model (Required)
# ------------------------------------------------------------------------------
# Cross-encoder reranker endpoint (e.g., Jina AI, SiliconFlow, or local sidecar).
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_BASE_URL=http://host.docker.internal:11434/v1
RERANKER_API_KEY=

# ------------------------------------------------------------------------------
# 4. Security & Access (Optional)
# ------------------------------------------------------------------------------
# When empty (default): Localhost access (127.0.0.1) does not require any password.
# When set: The entire application is protected with this password upon first visit.
API_AUTH_TOKEN=
